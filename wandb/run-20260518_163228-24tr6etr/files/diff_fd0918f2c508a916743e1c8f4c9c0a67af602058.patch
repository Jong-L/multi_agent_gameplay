+                    if "kl" not in stats and "learner_stats" in stats:
+                        stats = stats["learner_stats"]
+                    kl = stats.get("kl", float("nan"))
+                    pl = stats.get("policy_loss", float("nan"))
+                    vf = stats.get("vf_loss", float("nan"))
