\BKM@entry{id=30,dest={73756273656374696F6E2E352E31},srcline={1198}}{5C3337365C3337375C3133335C3337315C3134325C3131335C3135345C3134305C3132325C3033355C3133315C3331335C3132335C303236}
\@writefile{lof}{\contentsline {figure}{\numberline {5-1}{\ignorespaces 评估流程。阶段一：通过五阶段课程学习训练四个智能体的基础模型。阶段二：将四个智能体同时放入环境进行 IPPO 同步训练，使各智能体感知对手存在。阶段三：采用轮换冻结方式，每次仅训练一个智能体且冻结其余三方，多轮迭代后收集最近检查点构建对手池。阶段四：分别使用 IPPO 独立训练、简化联盟训练（PFSP 采样对手池）和虚拟博弈（对手策略平均化）三种方法训练智能体 0，得到三个待评估模型。阶段五：将三个模型分别与对手池中的策略进行对抗，通过胜率矩阵、历史对战表现评分和行为分析量化对比三种训练方法的泛化性能。}}{24}{figure.caption.18}\protected@file@percent }
\newlabel{fig:gameplay_evaluate}{{5-1}{24}{评估流程。阶段一：通过五阶段课程学习训练四个智能体的基础模型。阶段二：将四个智能体同时放入环境进行 IPPO 同步训练，使各智能体感知对手存在。阶段三：采用轮换冻结方式，每次仅训练一个智能体且冻结其余三方，多轮迭代后收集最近检查点构建对手池。阶段四：分别使用 IPPO 独立训练、简化联盟训练（PFSP 采样对手池）和虚拟博弈（对手策略平均化）三种方法训练智能体 0，得到三个待评估模型。阶段五：将三个模型分别与对手池中的策略进行对抗，通过胜率矩阵、历史对战表现评分和行为分析量化对比三种训练方法的泛化性能。}{figure.caption.18}{}}
